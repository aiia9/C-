using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
namespace ConsoleApp21
{
    class Car
    {
        private string brand;
        private string model;
        private int year;
        private int speed;
        public string Brand
        {
            get { return brand; }
            set { brand = value; }
        }
        public string Model
        {
            get { return model; }
            set { model = value; }
        }
        public int Year
        {
            get { return year; }
            set { year = value; }
        }
        public int Speed
        {
            get { return speed; }
            set
            {
                if (value >= 0)
                {
                    speed = value;
                }
                else
                {
                    speed = 0;
                    Console.WriteLine("Отрицательная скорость!");
                }
            }
        }
        public Car(string brand, string model, int year, int speed)
        {
            this.brand = brand;
            this.model = model;
            this.year = year;
            this.speed = speed;
        }
        public void Accelerate(int value)
        {
            speed = speed + value;
        }
        public void Info()
        {
            Console.WriteLine($"Марка автомобиля: {brand}");
            Console.WriteLine($"Модель: {model}");
            Console.WriteLine($"Год выпуска: {year}");
            Console.WriteLine($"Текущая скорость: {speed} км/ч");
            Console.WriteLine();
        }
    }
    class Program
    {
        static void Main()
        {
            Car first_car = new Car("BMW", "M5", 2022, 120);
            Car second_car = new Car("Toyota", "E9", 2011, 70);
            Console.WriteLine("Автомобиль 1");
            first_car.Info();
            Console.WriteLine("Автомобиль 2");
            second_car.Info();
            first_car.Speed = 200;
            first_car.Info();
            first_car.Speed = -200;
            first_car.Info();
            first_car.Accelerate(50);
            first_car.Info();
            Console.ReadKey();
        }
    }
}
